<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>Report</AssemblyName>
	<Version>1.2.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
	<SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<None Include="config.ini" CopyToOutputDirectory="PreserveNewest" />	
	<None Include="Hooks.cs" CopyToOutputDirectory="PreserveNewest" />	
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="ClosedXML.Report" Version="0.2.10" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="FluentModbus" Version="5.2.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="[4.3.1]" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="8.0.0" />
    <PackageReference Include="ScottPlot" Version="5.0.37" />
  </ItemGroup>
	
  <ItemGroup>
    <None Update="template.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
